{
  "name": "otools-aigv",
  "private": true,
  "version": "0.1.0",
  "description": "Novella（AI 漫剧 / 动画短剧 Multi-Agent 创作平台）的 OTools 插件版。上游为 Tauri v2 + React 19 + Rust，本仓库复刻其源码并适配 OTools 插件架构。",
  "author": "Agions",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "tsc && vite build",
    "lint": "pnpm exec eslint 'src/**/*.{ts,tsx}' --quiet",
    "lint:fix": "pnpm exec eslint 'src/**/*.{ts,tsx}' --fix",
    "check": "pnpm exec tsc --noEmit && pnpm run lint",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "madge:circular": "madge --circular --extensions ts,tsx --exclude '^(src/__tests|src/__mocks)' src",
    "knip": "knip --no-progress",
    "native:build": "cargo build --release -p otools-aigv-native",
    "native:test": "cargo test -p otools-aigv-native",
    "native:sync": "node scripts/sync-native-lib.mjs",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy-to-otools.ps1"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-store": "^2.4.2",
    "axios": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.10.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.74.0",
    "react-router-dom": "^7.15.0",
    "react-virtuoso": "^4.18.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "uuid": "^14.0.0",
    "zustand": "^4.4.6"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^4.3.4",
    "commitlint": "^20.5.3",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^72.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "knip": "^6.26.0",
    "less": "^4.2.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.6",
    "typescript": "^5.4.0",
    "vite": "^6.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
